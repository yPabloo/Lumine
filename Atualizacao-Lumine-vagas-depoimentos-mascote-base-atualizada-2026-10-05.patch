+/* Depoimentos */
+
+.testimonials-section {
+  overflow: hidden;
+  background:
+    radial-gradient(circle at 8% 12%, rgb(244 198 83 / 24%) 0 8%, transparent 8.5%),
+    radial-gradient(circle at 92% 88%, rgb(114 199 214 / 22%) 0 10%, transparent 10.5%),
+    linear-gradient(135deg, #fff8e4 0%, #fff2f7 52%, #edf9fb 100%);
+}
+
+.testimonials-heading {
+  max-width: 760px;
+  margin: 0 auto 2.5rem;
+  text-align: center;
+}
+
+.testimonials-heading h2 {
+  margin-bottom: 1rem;
+}
+
+.testimonials-heading p {
+  max-width: 650px;
+  margin: 0 auto;
+  color: var(--ink-soft);
+  line-height: 1.75;
+}
+
+.testimonial-carousel {
+  display: grid;
+  overflow: hidden;
+  max-width: 980px;
+  grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
+  margin-inline: auto;
+  border: 8px solid rgb(255 255 255 / 80%);
+  border-radius: 34px;
+  background: #ffffff;
+  box-shadow: 0 24px 65px rgb(78 56 72 / 12%);
+}
+
+.testimonial-video-wrap {
+  min-height: 500px;
+  background: #23384d;
+}
+
+.testimonial-video-wrap video {
+  display: block;
+  width: 100%;
+  height: 100%;
+  min-height: 500px;
+  border: 0;
+  background: #23384d;
+  object-fit: cover;
+}
+
+.testimonial-copy {
+  display: flex;
+  padding: clamp(2rem, 5vw, 3.5rem);
+  flex-direction: column;
+  justify-content: center;
+  background: linear-gradient(160deg, #ffffff, #fff8e8);
+}
+
+.testimonial-copy > svg {
+  width: 42px;
+  height: 42px;
+  margin-bottom: 1.5rem;
+  color: var(--rose);
+  fill: var(--pink-soft);
+}
+
+.testimonial-copy blockquote {
+  margin: 0 0 2rem;
+  color: var(--ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(1.35rem, 2.5vw, 2rem);
+  line-height: 1.45;
+}
+
+.testimonial-author {
+  display: flex;
+  gap: .9rem;
+  align-items: center;
+}
+
+.testimonial-author > span {
+  display: grid;
+  width: 46px;
+  height: 46px;
+  flex: 0 0 auto;
+  border-radius: 50%;
+  background: var(--pink-soft);
+  color: var(--rose-dark);
+  place-items: center;
+}
+
+.testimonial-author svg {
+  width: 21px;
+  height: 21px;
+}
+
+.testimonial-author strong,
+.testimonial-author small {
+  display: block;
+}
+
+.testimonial-author strong {
+  color: var(--ink);
+}
+
+.testimonial-author small {
+  margin-top: .2rem;
+  color: var(--ink-soft);
+}
+
+.testimonial-controls {
+  display: flex;
+  gap: .8rem;
+  align-items: center;
+  margin-top: 2rem;
+}
+
+.testimonial-controls > button {
+  display: grid;
+  width: 40px;
+  height: 40px;
+  padding: 0;
+  border: 1px solid var(--border);
+  border-radius: 50%;
+  background: #ffffff;
+  color: var(--ink);
+  cursor: pointer;
+  place-items: center;
+}
+
+.testimonial-controls > button:hover {
+  border-color: var(--rose);
+  color: var(--rose-dark);
+}
+
+.testimonial-dots {
+  display: flex;
+  flex: 1;
+  gap: .45rem;
+  justify-content: center;
+}
+
+.testimonial-dots button {
+  width: 9px;
+  height: 9px;
+  padding: 0;
+  border: 0;
+  border-radius: 999px;
+  background: #d9cdd2;
+  cursor: pointer;
+  transition: width 180ms ease, background-color 180ms ease;
+}
+
+.testimonial-dots .testimonial-dot--active {
+  width: 26px;
+  background: var(--rose);
+}
+
+.testimonial-empty {
+  display: flex;
+  max-width: 820px;
+  min-height: 190px;
+  gap: 1.25rem;
+  align-items: center;
+  justify-content: center;
+  margin-inline: auto;
+  padding: 2.25rem;
+  border: 2px dashed rgb(184 66 114 / 23%);
+  border-radius: 30px;
+  background: rgb(255 255 255 / 72%);
+  text-align: left;
+}
+
+.testimonial-empty-icon {
+  display: grid;
+  width: 62px;
+  height: 62px;
+  flex: 0 0 auto;
+  border-radius: 20px;
+  background: var(--pink-soft);
+  color: var(--rose-dark);
+  place-items: center;
+}
+
+.testimonial-empty-icon svg {
+  width: 28px;
+  height: 28px;
+}
+
+.testimonial-empty strong {
+  display: block;
+  margin-bottom: .4rem;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 1.35rem;
+}
+
+.testimonial-empty p {
+  margin: 0;
+  color: var(--ink-soft);
+  line-height: 1.6;
+}
+
+@media (max-width: 780px) {
+  .testimonial-carousel {
+    grid-template-columns: 1fr;
+  }
+
+  .testimonial-video-wrap,
+  .testimonial-video-wrap video {
+    min-height: 440px;
+  }
+}
+
+@media (max-width: 520px) {
+  .testimonial-carousel {
+    border-width: 5px;
+    border-radius: 25px;
+  }
+
+  .testimonial-video-wrap,
+  .testimonial-video-wrap video {
+    min-height: 390px;
+  }
+
+  .testimonial-empty {
+    display: grid;
+    justify-items: center;
+    text-align: center;
+  }
+}
